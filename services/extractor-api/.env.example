PORT=3000
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
FETCH_HTTP_TIMEOUT_MS=10000
# Retries after a connection error only (capped at 1; skipped when the browser fetcher can take over).
FETCH_HTTP_RETRIES=1
BROWSER_FETCH_ENABLED=true
BROWSER_FETCH_TIMEOUT_MS=15000
BROWSER_FETCH_CONCURRENCY=2
# One deadline for the whole /extract request (clamped to 5000-55000; the function's maxDuration is 60 s).
EXTRACT_REQUEST_DEADLINE_MS=50000
# URL-keyed cache of validated extraction successes (Upstash, in-memory without it). Kill switch + TTL.
EXTRACT_CACHE_ENABLED=true
EXTRACT_CACHE_TTL_SECONDS=604800
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_FALLBACK_TIMEOUT_MS=30000
LLM_FALLBACK_DAILY_BUDGET_USD=0
# Gemini cleanup of imported text; only runs when the text shows artifacts and LLM_PROVIDER is not none.
RECIPE_TEXT_CLEANUP_ENABLED=true
BILLING_ENFORCEMENT_ENABLED=false
REVENUECAT_SECRET_API_KEY=
REVENUECAT_V2_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_ENTITLEMENT_ID=Plus
REVENUECAT_PLUS_ENTITLEMENT_ID=Plus
REVENUECAT_FAMILY_ENTITLEMENT_ID=Family
WEB_BILLING_CHECKOUT_ENABLED=false
REVENUECAT_WEB_PURCHASE_LINK_PLUS_MONTHLY=
REVENUECAT_WEB_PURCHASE_LINK_PLUS_YEARLY=
REVENUECAT_WEB_PURCHASE_LINK_FAMILY_MONTHLY=
REVENUECAT_WEB_PURCHASE_LINK_FAMILY_YEARLY=
# Founding Plus: one-time lifetime Web Purchase Link that grants the Plus entitlement forever.
# Leave empty to keep the Founding Plus offer completely hidden on web.
REVENUECAT_WEB_PURCHASE_LINK_FOUNDING_LIFETIME=
FOUNDING_LIFETIME_PRICE_LABEL=$29.99
REVENUECAT_WEB_MANAGEMENT_URL=
BILLING_QUOTA_IDENTITY_SECRET=
FREE_LIFETIME_IMPORT_LIMIT=3
PLUS_MONTHLY_IMPORT_LIMIT=100
FAMILY_MONTHLY_IMPORT_LIMIT=250
PLUS_MONTHLY_PRICE_LABEL=$2.99
PLUS_YEARLY_PRICE_LABEL=$24.99
FAMILY_MONTHLY_PRICE_LABEL=$4.99
FAMILY_YEARLY_PRICE_LABEL=$44.99
LINKDISH_TEST_PREMIUM_USER_IDS=
LINKDISH_TEST_PREMIUM_PLAN_ID=family
HOUSEHOLDS_ENABLED=false
AUTH_MODE=legacy_email_code
AUTH_SECRET=
AUTH_CODE_TTL_SECONDS=600
AUTH_LOGIN_CODE_RATE_LIMIT_MAX=5
AUTH_LOGIN_CODE_RATE_LIMIT_WINDOW_MS=600000
AUTH_SESSION_TTL_SECONDS=7776000
APP_REVIEW_LOGIN_EMAILS=
APP_REVIEW_LOGIN_CODE=
CLERK_SECRET_KEY=
CLERK_JWT_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=
CLERK_JWT_KEY=
CLERK_WEBHOOK_SECRET=
HOUSEHOLD_INVITE_TTL_SECONDS=604800
HOUSEHOLD_MEMBER_LIMIT=6
HOUSEHOLD_REPLACEMENT_COOLDOWN_DAYS=30
LINKDISH_PUBLIC_SITE_URL=https://linkdish.ca
RESEND_API_KEY=
AUTH_EMAIL_FROM=
IOS_WAITLIST_EMAIL_FROM=
SUPPORT_EMAIL_TO=
SUPPORT_EMAIL_FROM=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_DASHBOARD_TOKEN=
ANALYTICS_ENABLED=false
ANALYTICS_DATABASE_URL=
ANALYTICS_HASH_SECRET=
ANALYTICS_RETENTION_DAYS=180
ANALYTICS_ROLLUP_RETENTION_DAYS=1095
