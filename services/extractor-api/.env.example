PORT=3000
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
FETCH_HTTP_TIMEOUT_MS=10000
# Retries after a connection error only (capped at 1; skipped when the browser fetcher can take over).
FETCH_HTTP_RETRIES=1
BROWSER_FETCH_ENABLED=true
BROWSER_FETCH_TIMEOUT_MS=15000
BROWSER_FETCH_CONCURRENCY=2
# Obey robots.txt for LinkDishBot before fetching any site people import from.
ROBOTS_TXT_ENFORCED=true
# Platform paths, checked against each platform's terms on 2026-11-08 (outputs/CONTENT-RIGHTS-REVIEW.md).
# The review found the YouTube, Instagram, Facebook and Pinterest terms (and TikTok's, for video
# downloads) do not permit automated reading without written permission. Robert decided on
# 2026-11-08 to turn them all back on by default, accepting that risk (Apple 5.2.2 and 5.2.3).
# Set any one to false to turn that path off on its own.
TIKTOK_IMPORT_ENABLED=true
YOUTUBE_IMPORT_ENABLED=true
INSTAGRAM_IMPORT_ENABLED=true
FACEBOOK_IMPORT_ENABLED=true
PINTEREST_IMPORT_ENABLED=true
# TikTok/Facebook video file downloads for the video reader (Apple guideline 5.2.3). They only
# happen while VIDEO_RECIPE_READER_ENABLED is on and GEMINI_API_KEY is set.
SOCIAL_VIDEO_DOWNLOAD_ENABLED=true
# One deadline for the whole /extract request (clamped to 5000-55000; the function's maxDuration is 60 s).
EXTRACT_REQUEST_DEADLINE_MS=50000
# URL-keyed cache of validated extraction successes (Upstash, in-memory without it). Kill switch + TTL.
EXTRACT_CACHE_ENABLED=true
EXTRACT_CACHE_TTL_SECONDS=604800
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# OpenAI is not used in production: leave OPENAI_API_KEY and OPENAI_MODEL empty in production.
# While OPENAI_API_KEY is set, the admin dashboard can switch extraction to OpenAI, and the privacy
# policy names Gemini as the only extraction provider.
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_FALLBACK_TIMEOUT_MS=30000
LLM_FALLBACK_DAILY_BUDGET_USD=0
# Gemini watches TikTok, Facebook and YouTube videos whose caption, description and linked pages
# have no written recipe. Needs GEMINI_API_KEY. On by default since 2026-11-08: the TikTok/Facebook
# video downloads above only feed this reader, so they do nothing while it is off. false turns the
# reader and every video download off.
VIDEO_RECIPE_READER_ENABLED=true
VIDEO_RECIPE_MODEL=gemini-3.8-flash
VIDEO_RECIPE_MAX_SECONDS=240
VIDEO_RECIPE_TIMEOUT_MS=40000
# Gemini video reads per UTC day (across instances with Upstash); 0 stops them.
VIDEO_RECIPE_DAILY_READ_LIMIT=300
# Gemini cleanup of imported text; only runs when the text shows artifacts and LLM_PROVIDER is not none.
RECIPE_TEXT_CLEANUP_ENABLED=true
BILLING_ENFORCEMENT_ENABLED=false
REVENUECAT_SECRET_API_KEY=
REVENUECAT_V2_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
REVENUECAT_ENTITLEMENT_ID=Plus
REVENUECAT_PLUS_ENTITLEMENT_ID=Plus
REVENUECAT_FAMILY_ENTITLEMENT_ID=Family
WEB_BILLING_CHECKOUT_ENABLED=false
REVENUECAT_WEB_PURCHASE_LINK_PLUS_MONTHLY=
REVENUECAT_WEB_PURCHASE_LINK_PLUS_YEARLY=
REVENUECAT_WEB_PURCHASE_LINK_FAMILY_MONTHLY=
REVENUECAT_WEB_PURCHASE_LINK_FAMILY_YEARLY=
# Founding Plus: one-time lifetime Web Purchase Link that grants the Plus entitlement for as long as we operate LinkDish.
# Leave empty to keep the Founding Plus offer completely hidden on web.
REVENUECAT_WEB_PURCHASE_LINK_FOUNDING_LIFETIME=
FOUNDING_LIFETIME_PRICE_LABEL=$29.99
REVENUECAT_WEB_MANAGEMENT_URL=
BILLING_QUOTA_IDENTITY_SECRET=
FREE_LIFETIME_IMPORT_LIMIT=3
PLUS_MONTHLY_IMPORT_LIMIT=100
FAMILY_MONTHLY_IMPORT_LIMIT=250
PLUS_MONTHLY_PRICE_LABEL=$2.99
PLUS_YEARLY_PRICE_LABEL=$24.99
FAMILY_MONTHLY_PRICE_LABEL=$4.99
FAMILY_YEARLY_PRICE_LABEL=$44.99
LINKDISH_TEST_PREMIUM_USER_IDS=
LINKDISH_TEST_PREMIUM_PLAN_ID=family
HOUSEHOLDS_ENABLED=false
# Personal cloud sync of signed-in accounts' cookbooks (GET/POST /library/changes).
LIBRARY_SYNC_ENABLED=false
AUTH_MODE=legacy_email_code
AUTH_SECRET=
AUTH_CODE_TTL_SECONDS=600
AUTH_LOGIN_CODE_RATE_LIMIT_MAX=5
AUTH_LOGIN_CODE_RATE_LIMIT_WINDOW_MS=600000
AUTH_SESSION_TTL_SECONDS=7776000
APP_REVIEW_LOGIN_EMAILS=
APP_REVIEW_LOGIN_CODE=
CLERK_SECRET_KEY=
CLERK_JWT_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=
CLERK_JWT_KEY=
CLERK_WEBHOOK_SECRET=
# Sign in with Apple token revocation when an account is deleted. Needs all four: the Apple Team ID,
# a Sign in with Apple key's ID and .p8 contents (newlines may be written as \n), and the iOS bundle
# ID. Without them deletion still works, but the person is told to turn off Sign in with Apple for
# LinkDish in their Apple Account settings themselves.
APPLE_SIGN_IN_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=
APPLE_SIGN_IN_CLIENT_ID=
HOUSEHOLD_INVITE_TTL_SECONDS=604800
HOUSEHOLD_MEMBER_LIMIT=6
HOUSEHOLD_REPLACEMENT_COOLDOWN_DAYS=30
LINKDISH_PUBLIC_SITE_URL=https://linkdish.ca
RESEND_API_KEY=
AUTH_EMAIL_FROM=
IOS_WAITLIST_EMAIL_FROM=
SUPPORT_EMAIL_TO=
SUPPORT_EMAIL_FROM=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_DASHBOARD_TOKEN=
# Named admin tokens, comma separated: name:token (token from `openssl rand -hex 32`).
ADMIN_DASHBOARD_TOKENS=
ADMIN_AUTH_FAILURE_LIMIT_MAX=10
ADMIN_AUTH_FAILURE_LIMIT_WINDOW_MS=900000
# Days the admin audit log is kept. The privacy policy keeps server logs for up to 90 days, so
# production must leave this unset or set it to 90 or less.
ADMIN_AUDIT_RETENTION_DAYS=90
ANALYTICS_ENABLED=false
ANALYTICS_DATABASE_URL=
ANALYTICS_HASH_SECRET=
# Days analytics are kept; older rows are purged daily. The privacy policy promises 90 days, so
# production must set both to 90 (unset keeps analytics indefinitely).
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_ROLLUP_RETENTION_DAYS=90
# Vercel Cron sends this as a bearer token to /admin/cron/* (daily analytics retention).
CRON_SECRET=
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
