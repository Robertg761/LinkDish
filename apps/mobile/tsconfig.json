{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    // Expo's base config resolves the "react-native" export condition, which makes TypeScript
    // type-check dependency sources (e.g. react-native-view-shot/src) under our strict flags.
    // Clearing it resolves their published .d.ts files instead.
    "customConditions": [],
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "app.config.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "plugins/**/*.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
