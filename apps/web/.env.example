# with `pnpm dev:api`.
VITE_LINKDISH_API_BASE_URL=https://api.linkdish.ca

# Optional. Enables Clerk UI when backend /auth/config also says Clerk is enabled.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_a25vd24tc2hhZC0zNi5jbGVyay5hY2NvdW50cy5kZXYk

# Optional. Enables RevenueCat Web SDK checkout instead of hosted Purchase Links.
VITE_REVENUECAT_WEB_PUBLIC_API_KEY=
