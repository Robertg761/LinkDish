{
  "name": "@linkdish/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json && tsc -p e2e/tsconfig.json",
    "size": "node scripts/bundle-size.ts",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@clerk/clerk-react": "5.61.8",
    "@linkdish/api-client": "workspace:*",
    "@linkdish/api-contracts": "workspace:*",
    "@linkdish/recipe-domain": "workspace:*",
    "@linkdish/utils": "workspace:*",
    "@revenuecat/purchases-js": "1.34.0",
    "idb": "^8.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.0.0",
    "typescript": "~5.9.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
